<UserControl x:Class="SSOInventoryManager.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:SSOInventoryManager.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
        <Border MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="40" CornerRadius="12"
                Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="4"/>
            </Border.Effect>

            <StackPanel>
                <!-- Header -->
                <TextBlock Text="SSO Inventory Manager"
                           Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Connect to your identity providers"
                           Style="{StaticResource MaterialDesignBody1TextBlock}"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground.Light}"
                           HorizontalAlignment="Center" Margin="0,0,0,32"/>

                <!-- Azure Section -->
                <TextBlock Text="AZURE / ENTRA ID"
                           Style="{StaticResource MaterialDesignOverlineTextBlock}"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                           Margin="0,0,0,12"/>

                <TextBox md:HintAssist.Hint="Tenant ID"
                         md:HintAssist.IsFloating="True"
                         Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,12"/>

                <TextBox md:HintAssist.Hint="Client ID (App Registration)"
                         md:HintAssist.IsFloating="True"
                         Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,16"/>

                <!-- Auth method toggle -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton Content="Device Code Flow"
                                 IsChecked="{Binding UseDeviceCodeFlow}"
                                 Style="{StaticResource MaterialDesignTabRadioButtonBottom}"
                                 Margin="0,0,12,0"/>
                    <RadioButton Content="Client Secret (Service Principal)"
                                 IsChecked="{Binding UseServicePrincipal}"
                                 Style="{StaticResource MaterialDesignTabRadioButtonBottom}"/>
                </StackPanel>

                <TextBox md:HintAssist.Hint="Client Secret"
                         md:HintAssist.IsFloating="True"
                         Text="{Binding ClientSecret, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,16"
                         Visibility="{Binding UseServicePrincipal, Converter={StaticResource BoolToVis}}"/>

                <!-- Separator -->
                <Separator Margin="0,8,0,20" Background="{DynamicResource MaterialDesign.Brush.Separator}"/>

                <!-- ADFS Section -->
                <TextBlock Text="ADFS (OPTIONAL)"
                           Style="{StaticResource MaterialDesignOverlineTextBlock}"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                           Margin="0,0,0,12"/>

                <TextBox md:HintAssist.Hint="ADFS Server (e.g. adfs.contoso.com)"
                         md:HintAssist.IsFloating="True"
                         Text="{Binding AdfsServer, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,24"/>

                <!-- Device code message -->
                <Border Background="{DynamicResource MaterialDesign.Brush.Primary}"
                        CornerRadius="6" Padding="16" Margin="0,0,0,16"
                        Visibility="{Binding DeviceCodeMessage, Converter={StaticResource NullToVis}}">
                    <Border.Resources>
                        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
                    </Border.Resources>
                    <TextBlock Text="{Binding DeviceCodeMessage}" TextWrapping="Wrap"
                               Foreground="White" FontFamily="Consolas"/>
                </Border>

                <!-- Status message -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                           TextWrapping="Wrap" Margin="0,0,0,16"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                    <TextBlock.Resources>
                        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
                    </TextBlock.Resources>
                </TextBlock>

                <!-- Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="CONNECT" Command="{Binding ConnectCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="6"
                            IsEnabled="{Binding IsConnecting, Converter={StaticResource InverseBool}}"
                            Height="40" FontSize="14"/>

                    <Button Grid.Column="1" Content="CLEAR"
                            Command="{Binding ClearConfigCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            md:ButtonAssist.CornerRadius="6"
                            Margin="12,0,0,0" Height="40"/>
                </Grid>

                <!-- Loading indicator -->
                <ProgressBar IsIndeterminate="True" Margin="0,16,0,0"
                             Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
