<UserControl x:Class="SSOInventoryManager.Views.DetailPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:SSOInventoryManager.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToEnabledTextConverter x:Key="BoolToEnabled"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock"
               BasedOn="{StaticResource MaterialDesignCaptionTextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground.Light}"/>
            <Setter Property="Margin" Value="0,12,0,2"/>
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
            BorderBrush="{DynamicResource MaterialDesign.Brush.Separator}"
            BorderThickness="1,0,0,0">
        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top" Padding="16,12"
                    Background="{DynamicResource MaterialDesign.Brush.Primary}">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Foreground="White" ToolTip="Close">
                        <md:PackIcon Kind="Close"/>
                    </Button>
                    <TextBlock Text="Application Details"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Foreground="White" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Scrollable content -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>
                    <!-- Azure Detail -->
                    <StackPanel Visibility="{Binding DataContext.IsAzureDetailSelected,
                                RelativeSource={RelativeSource AncestorType=Window},
                                Converter={StaticResource BoolToVis}}">

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Display Name"/>
                        <TextBox Style="{StaticResource FieldValue}" Text="{Binding DataContext.SelectedAzureApp.DisplayName, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="App ID"/>
                        <TextBox Style="{StaticResource FieldValue}" Text="{Binding DataContext.SelectedAzureApp.AppId, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="SSO Mode"/>
                        <TextBox Style="{StaticResource FieldValue}" Text="{Binding DataContext.SelectedAzureApp.SsoMode, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Sign-In Audience"/>
                        <TextBox Style="{StaticResource FieldValue}" Text="{Binding DataContext.SelectedAzureApp.SignInAudience, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Publisher Domain"/>
                        <TextBox Style="{StaticResource FieldValue}" Text="{Binding DataContext.SelectedAzureApp.PublisherDomain, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Enabled"/>
                        <TextBox Style="{StaticResource FieldValue}" Text="{Binding DataContext.SelectedAzureApp.Enabled, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource BoolToEnabled}}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Assigned Users / Groups"/>
                        <TextBox Style="{StaticResource FieldValue}" Text="{Binding DataContext.SelectedAzureApp.AssignedUsersGroups, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Last Sign-In"/>
                        <TextBox Style="{StaticResource FieldValue}" Text="{Binding DataContext.SelectedAzureApp.LastSignIn, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Homepage URL"/>
                        <TextBox Style="{StaticResource FieldValue}" Text="{Binding DataContext.SelectedAzureApp.HomepageUrl, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Reply URLs"/>
                        <TextBox Style="{StaticResource FieldValue}" Text="{Binding DataContext.SelectedAzureApp.ReplyUrls, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="App Type"/>
                        <TextBox Style="{StaticResource FieldValue}" Text="{Binding DataContext.SelectedAzureApp.AppType, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Notes"/>
                        <TextBox md:HintAssist.Hint="Add notes..."
                                 Text="{Binding DataContext.SelectedAzureApp.Notes, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="80" Margin="0,4,0,0"/>

                        <CheckBox Content="Flag for Review" Margin="0,12,0,0"
                                  IsChecked="{Binding DataContext.SelectedAzureApp.FlaggedForReview, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Style="{StaticResource MaterialDesignCheckBox}"/>
                    </StackPanel>

                    <!-- ADFS Detail -->
                    <StackPanel Visibility="{Binding DataContext.IsAdfsDetailSelected,
                                RelativeSource={RelativeSource AncestorType=Window},
                                Converter={StaticResource BoolToVis}}">

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Display Name"/>
                        <TextBox Style="{StaticResource FieldValue}" Text="{Binding DataContext.SelectedAdfsApp.DisplayName, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Identifier (EntityID)"/>
                        <TextBox Style="{StaticResource FieldValue}" Text="{Binding DataContext.SelectedAdfsApp.Identifier, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Protocol"/>
                        <TextBox Style="{StaticResource FieldValue}" Text="{Binding DataContext.SelectedAdfsApp.Protocol, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Enabled"/>
                        <TextBox Style="{StaticResource FieldValue}" Text="{Binding DataContext.SelectedAdfsApp.Enabled, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource BoolToEnabled}}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Monitoring Enabled"/>
                        <TextBox Style="{StaticResource FieldValue}" Text="{Binding DataContext.SelectedAdfsApp.MonitoringEnabled, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, Converter={StaticResource BoolToEnabled}}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Last Updated"/>
                        <TextBox Style="{StaticResource FieldValue}" Text="{Binding DataContext.SelectedAdfsApp.LastUpdated, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Endpoint URLs"/>
                        <TextBox Style="{StaticResource FieldValue}" Text="{Binding DataContext.SelectedAdfsApp.EndpointUrls, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Issuance Rules Count"/>
                        <TextBox Style="{StaticResource FieldValue}" Text="{Binding DataContext.SelectedAdfsApp.IssuanceRulesCount, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Notes"/>
                        <TextBox md:HintAssist.Hint="Add notes..."
                                 Text="{Binding DataContext.SelectedAdfsApp.Notes, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="80" Margin="0,4,0,0"/>

                        <CheckBox Content="Flag for Review" Margin="0,12,0,0"
                                  IsChecked="{Binding DataContext.SelectedAdfsApp.FlaggedForReview, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Style="{StaticResource MaterialDesignCheckBox}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
